{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist/auth",
    "rootDir": "src/auth",
    "sourceMap": true
  },
  "include": ["src/auth/**/*.ts", "src/auth/**/*.tsx"],
  "exclude": [
    "src/auth/**/*.test.ts",
    "src/auth/**/*.test.tsx",
    "src/auth/test-setup.ts"
  ]
}
